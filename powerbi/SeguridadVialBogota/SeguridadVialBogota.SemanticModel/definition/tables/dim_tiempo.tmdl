table dim_tiempo

	column id_tiempo
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_tiempo

	column fecha
		dataType: date
		summarizeBy: none
		sourceColumn: fecha

	column anio
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: anio

	column mes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: mes

	column nombre_mes
		dataType: string
		summarizeBy: none
		sourceColumn: nombre_mes

	column dia_semana
		dataType: string
		summarizeBy: none
		sourceColumn: dia_semana

	column hora
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: hora

	column franja_horaria
		dataType: string
		summarizeBy: none
		sourceColumn: franja_horaria

	partition dim_tiempo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\dim_tiempo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Remove(_, {Character.FromNumber(65279)})),
				    Tipado = Table.TransformColumnTypes(Limpio, {{"id_tiempo", Int64.Type}, {"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"nombre_mes", type text}, {"dia_semana", type text}, {"hora", Int64.Type}, {"franja_horaria", type text}})
				in
				    Tipado

	annotation PBI_ResultType = Table
