table dim_gravedad

	column id_gravedad
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_gravedad

	column gravedad
		dataType: string
		summarizeBy: none
		sourceColumn: gravedad

	partition dim_gravedad = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\dim_gravedad.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Remove(_, {Character.FromNumber(65279)})),
				    Tipado = Table.TransformColumnTypes(Limpio, {{"id_gravedad", Int64.Type}, {"gravedad", type text}})
				in
				    Tipado

	annotation PBI_ResultType = Table
