table fact_siniestros

	measure TotalSiniestros = COUNTROWS ( fact_siniestros )
		formatString: #,0

	measure SiniestrosConHeridos = CALCULATE ( [TotalSiniestros], dim_gravedad[gravedad] = "CON HERIDOS" )
		formatString: #,0

	measure SiniestrosConMuertos = CALCULATE ( [TotalSiniestros], dim_gravedad[gravedad] = "CON MUERTOS" )
		formatString: #,0

	measure SiniestrosSoloDanos = CALCULATE ( [TotalSiniestros], dim_gravedad[gravedad] = "SOLO DAÑOS" )
		formatString: #,0

	measure PctLesionados = DIVIDE ( [SiniestrosConHeridos] + [SiniestrosConMuertos], [TotalSiniestros] )
		formatString: 0.0%

	measure SiniestrosPor100k = DIVIDE ( [TotalSiniestros] * 100000, AVERAGEX ( VALUES ( dim_tiempo[anio] ), CALCULATE ( SUM ( poblacion_localidad[poblacion] ) ) ) )
		formatString: #,0

	column id_siniestro
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_siniestro

	column codigo_accidente
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: codigo_accidente

	column id_tiempo
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_tiempo

	column id_localidad
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_localidad

	column id_gravedad
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_gravedad

	column id_clase
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_clase

	column direccion
		dataType: string
		summarizeBy: none
		sourceColumn: direccion

	column latitud
		dataType: double
		summarizeBy: none
		sourceColumn: latitud

	column longitud
		dataType: double
		summarizeBy: none
		sourceColumn: longitud

	column civ
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: civ

	column pk_calzada
		dataType: double
		summarizeBy: none
		sourceColumn: pk_calzada

	partition fact_siniestros = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\fact_siniestros.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Remove(_, {Character.FromNumber(65279)})),
				    Tipado = Table.TransformColumnTypes(Limpio, {{"id_siniestro", Int64.Type}, {"codigo_accidente", Int64.Type}, {"id_tiempo", Int64.Type}, {"id_localidad", Int64.Type}, {"id_gravedad", Int64.Type}, {"id_clase", Int64.Type}, {"direccion", type text}, {"latitud", type number}, {"longitud", type number}, {"civ", Int64.Type}, {"pk_calzada", type number}})
				in
				    Tipado

	annotation PBI_ResultType = Table
