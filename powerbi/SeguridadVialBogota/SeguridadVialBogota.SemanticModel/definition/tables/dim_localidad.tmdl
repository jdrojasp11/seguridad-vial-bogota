table dim_localidad

	column codigo_localidad
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: codigo_localidad

	column nombre_localidad
		dataType: string
		summarizeBy: none
		sourceColumn: nombre_localidad

	partition dim_localidad = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\dim_localidad.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Limpio = Table.TransformColumnNames(Encabezados, each Text.Remove(_, {Character.FromNumber(65279)})),
				    Tipado = Table.TransformColumnTypes(Limpio, {{"codigo_localidad", Int64.Type}, {"nombre_localidad", type text}})
				in
				    Tipado

	annotation PBI_ResultType = Table
