{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "lineanual",
  "position": {
    "x": 20,
    "y": 240,
    "z": 300,
    "height": 300,
    "width": 610,
    "tabOrder": 300
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_tiempo"
                    }
                  },
                  "Property": "anio"
                }
              },
              "queryRef": "dim_tiempo.anio",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_siniestros"
                    }
                  },
                  "Property": "TotalSiniestros"
                }
              },
              "queryRef": "fact_siniestros.TotalSiniestros"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}